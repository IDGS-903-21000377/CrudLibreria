DELIMITER //

CREATE PROCEDURE insertar_libro(
    IN p_titulo VARCHAR(233),
    IN p_autor VARCHAR(233),
    IN p_genero VARCHAR(233),
    IN p_anio DOUBLE
)
BEGIN

    INSERT INTO libros(titulo, autor, genero, anio)
    VALUES(p_titulo, p_autor, p_genero, p_anio);

END //

DELIMITER ;


